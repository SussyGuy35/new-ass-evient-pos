rs__preorder_id__get", "parameters": [{"name": "preorder_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Preorder Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PreOrderResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "delete": {"tags": ["PreOrders"], "summary": "Cancel Preorder", "description": "Cancel a pre-order (soft delete \u2014 sets status to 'cancelled').", "operationId": "cancel_preorder_api_preorders__preorder_id__delete", "parameters": [{"name": "preorder_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Preorder Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/preorders/fulfill/{barcode_code}": {"post": {"tags": ["PreOrders"], "summary": "Fulfill Preorder", "description": "Fulfill a pending pre-order: create a real order, deduct stock, update status.", "operationId": "fulfill_preorder_api_preorders_fulfill__barcode_code__post", "parameters": [{"name": "barcode_code", "in": "path", "required": true, "schema": {"type": "string", "title": "Barcode Code"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/preorders/{preorder_id}/resend-email": {"post": {"tags": ["PreOrders"], "summary": "Resend Preorder Email", "description": "Resend email notification for a pre-order.", "operationId": "resend_preorder_email_api_preorders__preorder_id__resend_email_post", "parameters": [{"name